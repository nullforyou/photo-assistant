# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

# Walk upward from a starting directory looking for `relative`; returns the first
# absolute path that exists, or nil when the filesystem root is reached.
def walk_up_for_file(start_dir, relative)
  dir = File.expand_path(start_dir)
  loop do
    candidate = File.join(dir, relative)
    return candidate if File.exist?(candidate)
    parent = File.expand_path('..', dir)
    break if parent == dir
    dir = parent
  end
  nil
end

def flutter_root
  # Flutter 3.x writes FLUTTER_ROOT into one of these generated xcconfig files.
  xcconfig_candidates = [
    File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__),
    File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Generated.xcconfig'), __FILE__),
  ]
  xcconfig = xcconfig_candidates.find { |p| File.exist?(p) }
  unless xcconfig
    raise "#{xcconfig_candidates.first} must exist. If you're running pod install manually, make sure flutter pub get is executed first."
  end

  File.foreach(xcconfig) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{xcconfig}. Try deleting Generated.xcconfig, then run flutter pub get"
end

# Locate flutter_tools' podhelper robustly. On some CI setups FLUTTER_ROOT points at
# <sdk>/bin/cache, so we search upward from it (and, as a fallback, from the `flutter`
# binary found on PATH) for packages/flutter_tools/bin/podhelper.
# 定位 flutter_tools 的 podhelper。Flutter 3.47 里该文件实际叫
# `packages/flutter_tools/bin/podhelper.rb`（带 .rb 后缀）；Ruby 的 `require` 能自动
# 补 .rb，但裸 File.exist? 不带头缀会找不到。这里两种后缀都试。
def find_podhelper
  relative = File.join('packages', 'flutter_tools', 'bin', 'podhelper')
  # 候选 SDK 根：Generated.xcconfig 里的 FLUTTER_ROOT，以及 `which flutter` 推导出的根。
  roots = [flutter_root]
  flutter_bin = `which flutter`.strip
  unless flutter_bin.empty?
    roots << File.expand_path(File.join('..', '..'), File.dirname(flutter_bin))
  end
  extensions = ['', '.rb']
  roots.each do |root|
    # 直接子目录（CI：FLUTTER_ROOT 指向 SDK 根本身）。
    extensions.each do |ext|
      cand = File.join(root, relative + ext)
      return cand if File.exist?(cand)
    end
    # 向上搜索（FLUTTER_ROOT 指向 <sdk>/bin/cache 等更深层级时）。
    extensions.each do |ext|
      found = walk_up_for_file(root, relative + ext)
      return found if found
    end
  end
  # 兜底：返回规范路径，让 `require` 自行补 .rb 后缀解析。
  File.join(flutter_root, relative)
end

podhelper = find_podhelper
raise "Could not locate flutter_tools podhelper (FLUTTER_ROOT=#{flutter_root}). Make sure flutter pub get has run." if podhelper.nil?
require podhelper

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
